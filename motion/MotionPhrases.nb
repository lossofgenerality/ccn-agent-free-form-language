(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{
Cell["Motion phrases", "Title"],

Cell["MotionPhrases: reads spoken motion phrases, such as\n\"move along the path while spinning counterclockwise and move upwards\",\nor whole paragraphs with motion phrases inside them, and turns each motion into a\nWolfram Language RotationTransform or TranslationTransform.\nThe first of the simple operations for the CCN agent free-form language.", "Text"],

Cell["Load:  open this notebook and evaluate it (its cells are initialisation cells), or from\nanother notebook: NotebookEvaluate[\"<folder>/MotionPhrases.nb\"]. In the cloud,\nCloudDeploy or CopyFile this notebook to your cloud and NotebookEvaluate it there.", "Text"],

Cell["Use:   MotionReport[text]        how each part was read, what was assumed, what was set aside\nMotionFind[text]          the motion parts found in a longer text, and what was set aside\nMotionFormula[text]       each step as RotationTransform . TranslationTransform (inactive)\nMotionTransform[text, t]  the TransformationFunction at time t (0 to 1)\nMotionPlot[text]          snapshots along the motion;  MotionAnimate[text]", "Text"],

Cell["By Dara O Shayda and Hikari Noor Hoshino (\:661f\:91ce\:30cc\:30fc\:30eb), AI System Programmer", "Text"],

Cell["BeginPackage[\"MotionPhrases`\"];", "Code"],

Cell["MotionParse::usage = \"MotionParse[text] reads a motion phrase or a longer text and gives an Association: its steps, the meaning of each part, the transform formula of each step, where the object ends, what was set aside, and a report.\";\nMotionFind::usage = \"MotionFind[text] gives the motion parts found in a text, step by step, and the parts set aside with the reason.\";\nMotionFormula::usage = \"MotionFormula[text] gives the transform of each step as an inactive composition of RotationTransform and TranslationTransform in the step time \\[FormalT], from 0 to 1. Activate it to get a TransformationFunction.\";\nMotionTransform::usage = \"MotionTransform[text, t] gives the TransformationFunction at time t, from 0 to 1 over the whole text. For a symbolic t it gives the formula of a one-step text, or a list of {{from, to}, transform} for each step.\";\nMotionReport::usage = \"MotionReport[text] shows how each part was read, what was assumed, what was corrected and what was set aside.\";\nMotionPlot::usage = \"MotionPlot[text] draws the object at several times along its motion, with the path of its centre.\";\nMotionAnimate::usage = \"MotionAnimate[text] animates the object over its motion.\";\nMotionSubject::usage = \"MotionSubject[part] gives what a subject check sees of one motion part: the words before its motion verb (\\\"Own\\\"), the verb, the words after it, the part before it in the same sentence (\\\"Prev\\\", when Own is empty) and the word joining them (\\\"Join\\\").\";\n$MotionVocabulary::usage = \"$MotionVocabulary holds the words and figures of speech MotionParse knows, by kind. Add to its lists to extend the language.\";", "Code"],

Cell["Begin[\"`Private`\"];", "Code"],

Cell["The words", "Section"],

Cell["$MotionVocabulary = <|\n  \"translate\" -> {\"move\", \"moves\", \"moving\", \"moved\", \"go\", \"goes\", \"going\", \"went\", \"gone\", \"travel\", \"travels\",\n    \"travelling\", \"traveling\", \"travelled\", \"traveled\", \"slide\", \"slides\", \"sliding\", \"slid\", \"glide\", \"glides\",\n    \"gliding\", \"glided\", \"drift\", \"drifts\", \"drifting\", \"drifted\", \"shift\", \"shifts\", \"shifting\", \"shifted\",\n    \"head\", \"heads\", \"heading\", \"headed\", \"walk\", \"walks\", \"walking\", \"walked\", \"fly\", \"flies\", \"flying\", \"flew\",\n    \"flown\", \"translate\", \"translates\", \"translating\", \"translated\", \"step\", \"stepping\", \"stepped\",\n    \"come\", \"comes\", \"coming\", \"came\"},\n  \"rise\" -> {\"rise\", \"rises\", \"rising\", \"rose\", \"risen\", \"climb\", \"climbs\", \"climbing\", \"climbed\", \"ascend\",\n    \"ascends\", \"ascending\", \"ascended\", \"lift\", \"lifts\", \"lifting\", \"lifted\", \"raise\", \"raises\", \"raising\", \"raised\"},\n  \"sink\" -> {\"sink\", \"sinks\", \"sinking\", \"sank\", \"sunk\", \"fall\", \"falls\", \"falling\", \"fell\", \"fallen\", \"drop\",\n    \"drops\", \"dropping\", \"dropped\", \"descend\", \"descends\", \"descending\", \"descended\", \"lower\", \"lowers\",\n    \"lowering\", \"lowered\"},\n  \"spin\" -> {\"spin\", \"spins\", \"spinning\", \"spun\", \"rotate\", \"rotates\", \"rotating\", \"rotated\", \"turn\", \"turns\",\n    \"turning\", \"turned\", \"twist\", \"twists\", \"twisting\", \"twisted\", \"twirl\", \"twirls\", \"twirling\", \"twirled\",\n    \"roll\", \"rolls\", \"rolling\", \"rolled\", \"pivot\", \"pivots\", \"pivoting\", \"pivoted\", \"swivel\", \"swivels\",\n    \"swivelling\", \"swiveling\", \"swivelled\", \"swiveled\", \"whirl\", \"whirls\", \"whirling\", \"whirled\"},\n  \"orbit\" -> {\"orbit\", \"orbits\", \"orbiting\", \"orbited\", \"revolve\", \"revolves\", \"revolving\", \"revolved\", \"circle\",\n    \"circles\", \"circling\", \"circled\"},\n  \"follow\" -> {\"follow\", \"follows\", \"following\", \"followed\", \"trace\", \"traces\", \"tracing\", \"traced\"},\n  \"pause\" -> {\"pause\", \"pauses\", \"pausing\", \"paused\", \"wait\", \"waits\", \"waiting\", \"waited\", \"hold\", \"holds\",\n    \"holding\", \"held\", \"stay\", \"stays\", \"staying\", \"stayed\", \"stop\", \"stops\", \"stopping\", \"stopped\", \"halt\",\n    \"halts\", \"halted\"},\n  \"directions\" -> <|\n    \"up\" -> {0, 0, 1}, \"upward\" -> {0, 0, 1}, \"upwards\" -> {0, 0, 1},\n    \"down\" -> {0, 0, -1}, \"downward\" -> {0, 0, -1}, \"downwards\" -> {0, 0, -1},\n    \"left\" -> {-1, 0, 0}, \"leftward\" -> {-1, 0, 0}, \"leftwards\" -> {-1, 0, 0},\n    \"right\" -> {1, 0, 0}, \"rightward\" -> {1, 0, 0}, \"rightwards\" -> {1, 0, 0},\n    \"forward\" -> {0, 1, 0}, \"forwards\" -> {0, 1, 0}, \"ahead\" -> {0, 1, 0},\n    \"back\" -> {0, -1, 0}, \"backward\" -> {0, -1, 0}, \"backwards\" -> {0, -1, 0}|>,\n  \"axes\" -> <|\"x\" -> {1, 0, 0}, \"y\" -> {0, 1, 0}, \"z\" -> {0, 0, 1}, \"vertical\" -> {0, 0, 1}|>,\n  \"senses\" -> <|\"counterclockwise\" -> 1, \"clockwise\" -> -1|>,\n  \"numbers\" -> <|\"a\" -> 1, \"an\" -> 1, \"one\" -> 1, \"two\" -> 2, \"three\" -> 3, \"four\" -> 4, \"five\" -> 5,\n    \"six\" -> 6, \"seven\" -> 7, \"eight\" -> 8, \"nine\" -> 9, \"ten\" -> 10, \"half\" -> 1/2, \"quarter\" -> 1/4,\n    \"once\" -> 1, \"twice\" -> 2, \"thrice\" -> 3, \"full\" -> 1, \"whole\" -> 1, \"andahalf\" -> 1/2, \"andaquarter\" -> 1/4|>,\n  \"angleUnits\" -> {\"degree\", \"degrees\", \"radian\", \"radians\", \"turn\", \"turns\", \"revolution\", \"revolutions\",\n    \"rotation\", \"rotations\", \"time\", \"times\"},\n  \"distanceUnits\" -> {\"unit\", \"units\", \"metre\", \"metres\", \"meter\", \"meters\", \"step\", \"steps\", \"centimetre\",\n    \"centimetres\", \"centimeter\", \"centimeters\"},\n  \"places\" -> {\"path\", \"origin\", \"center\", \"point\"},\n  \"other\" -> {\"the\", \"its\", \"it\", \"itself\", \"own\", \"s\", \"to\", \"of\", \"by\", \"with\", \"in\", \"on\", \"at\",\n    \"around\", \"about\", \"along\", \"axis\", \"direction\", \"way\", \"from\", \"into\", \"onto\", \"toward\", \"towards\",\n    \"object\", \"body\", \"keep\", \"keeps\", \"keeping\", \"also\", \"too\", \"same\", \"is\", \"be\", \"all\", \"each\", \"then\",\n    \"will\", \"should\", \"must\", \"can\", \"now\", \"just\", \"please\", \"so\", \"you\", \"we\", \"i\", \"let\", \"lets\", \"us\"},\n  (* Figures of speech that use motion words without meaning a motion; set aside before reading *)\n  \"idioms\" -> {\n    \"\\\\bturn(?:s|ed|ing)? (?:on|off|out|into|in)\\\\b\", \"\\\\bturn(?:s|ed|ing)? (?:the|a) page\\\\b\",\n    \"\\\\bturn of (?:events|phrase)\\\\b\", \"\\\\bupside down\\\\b\",\n    \"\\\\bmov(?:e|es|ed|ing) on(?: to)?\\\\b\", \"\\\\bmov(?:e|es|ed|ing) (?:in|out|house)\\\\b\",\n    \"\\\\b(?:go|goes|went|going) (?:on|out|ahead and|over)\\\\b\", \"^going forward\\\\b\",\n    \"\\\\b(?:look|looks|looked|looking) up\\\\b\", \"\\\\bpick(?:s|ed|ing)? (?:\\\\w+ )?up\\\\b\",\n    \"\\\\bup to (?:you|date|now|speed|something|no good)\\\\b\", \"\\\\bright (?:now|away|here|there)\\\\b\",\n    \"\\\\ball right\\\\b\", \"\\\\bback then\\\\b\",\n    \"\\\\b(?:rise|rises|rose|risen|rising|fall|falls|fell|fallen|falling|drop|drops|dropped|dropping|climb|climbs|climbed|climbing|sink|sinks|sank|sinking|go|goes|went|gone|going) (?:up |down )?(?:to|by) [0-9.]+ ?(?:percent|per cent|%)\",\n    \"\\\\bpath to (?:success|victory|recovery|peace|freedom|glory|happiness)\\\\b\",\n    \"\\\\b(?:get|got|getting) the ball rolling\\\\b\", \"\\\\bdrop(?:s|ped|ping)? the ball\\\\b\",\n    \"\\\\bcircle(?:s|d)? back\\\\b\", \"\\\\bfall(?:s|ing)? behind\\\\b\", \"\\\\bfell behind\\\\b\",\n    \"\\\\bstep(?:s|ped|ping)? (?:up|down) as\\\\b\", \"\\\\bspin doctor\\\\b\", \"\\\\brolling hills\\\\b\"}\n|>;", "Code"],

Cell["(* Word lists built from the vocabulary, remembered for each version of it *)\nverbForms[] := verbFormsOf[$MotionVocabulary];\nverbFormsOf[v_] := verbFormsOf[v] = Union[Flatten[Lookup[v, {\"translate\", \"rise\", \"sink\", \"spin\", \"orbit\", \"follow\", \"pause\"}]]];", "Code"],

Cell["knownWords[] := knownWordsOf[$MotionVocabulary];\nknownWordsOf[v_] := knownWordsOf[v] = Union[Flatten[{Lookup[v,\n     {\"translate\", \"rise\", \"sink\", \"spin\", \"orbit\", \"follow\", \"pause\", \"angleUnits\", \"distanceUnits\", \"places\", \"other\"}],\n    Keys /@ Lookup[v, {\"directions\", \"axes\", \"senses\", \"numbers\"}]}]];", "Code"],

Cell["$numberWords = <|\"zero\" -> 0, \"one\" -> 1, \"two\" -> 2, \"three\" -> 3, \"four\" -> 4, \"five\" -> 5, \"six\" -> 6,\n   \"seven\" -> 7, \"eight\" -> 8, \"nine\" -> 9, \"ten\" -> 10, \"eleven\" -> 11, \"twelve\" -> 12, \"thirteen\" -> 13,\n   \"fourteen\" -> 14, \"fifteen\" -> 15, \"sixteen\" -> 16, \"seventeen\" -> 17, \"eighteen\" -> 18, \"nineteen\" -> 19,\n   \"twenty\" -> 20, \"thirty\" -> 30, \"forty\" -> 40, \"fifty\" -> 50, \"sixty\" -> 60, \"seventy\" -> 70, \"eighty\" -> 80,\n   \"ninety\" -> 90, \"hundred\" -> 100, \"thousand\" -> 1000|>;", "Code"],

Cell["Tidying a sentence", "Section"],

Cell["$unitsAhead = \"(?=\\\\s+(?:units?|steps?|turns?|times|degrees|metres?|meters?|centimetres?|centimeters?|and an? (?:half|quarter))\\\\b)\";", "Code"],

Cell["(* common slips of dictation: words split apart, and homophones where the meaning is clear *)\ndictationFixes[] := {\n   RegularExpression[\"\\\\b(?:counter|anti)[- ]?clock[- ]?wise\\\\b\"] -> \"counterclockwise\",\n   RegularExpression[\"\\\\bclock[- ]wise\\\\b\"] -> \"clockwise\",\n   RegularExpression[\"\\\\bup wards\\\\b\"] -> \"upwards\", RegularExpression[\"\\\\bdown wards\\\\b\"] -> \"downwards\",\n   RegularExpression[\"\\\\bback wards\\\\b\"] -> \"backwards\", RegularExpression[\"\\\\bfor wards\\\\b\"] -> \"forwards\",\n   RegularExpression[\"\\\\bfor ward\\\\b\"] -> \"forward\",\n   RegularExpression[\"\\\\bex[- ]axis\\\\b\"] -> \"x axis\", RegularExpression[\"\\\\bwhy[- ]axis\\\\b\"] -> \"y axis\",\n   RegularExpression[\"\\\\bze[de][- ]axis\\\\b\"] -> \"z axis\",\n   RegularExpression[\"\\\\bwrite\\\\b\"] -> \"right\",\n   RegularExpression[\"\\\\btoo\\\\b\" <> $unitsAhead] -> \"two\",\n   RegularExpression[\"\\\\bfor\\\\b\" <> $unitsAhead] -> \"four\",\n   RegularExpression[\"\\\\bwon\\\\b(?!')\"] -> \"one\",\n   RegularExpression[\"(^|,\\\\s*|\\\\band\\\\s+)than\\\\b\"] -> \"$1then\",\n   RegularExpression[\"\\\\bthan\\\\b(?=\\\\s+(?:\" <> StringRiffle[verbForms[], \"|\"] <> \")\\\\b)\"] -> \"then\"};", "Code"],

Cell["numberWordsRE[] := With[{nw = StringRiffle[Keys[$numberWords], \"|\"]},\n   RegularExpression[\"\\\\b(?:a\\\\s+(?=hundred|thousand))?(?:\" <> nw <> \")(?:(?:(?<=hundred|thousand)\\\\s+and\\\\s+|[\\\\s-]+)(?:\" <> nw <> \"))*\\\\b\"]];", "Code"],

Cell["wordsToNumber[s_String] := Module[{total = 0, cur = 0},\n  Do[Which[\n    t === \"a\" || t === \"and\", Null,\n    t === \"hundred\", cur = Max[cur, 1]*100,\n    t === \"thousand\", total += Max[cur, 1]*1000; cur = 0,\n    True, cur += $numberWords[t]],\n   {t, StringCases[s, RegularExpression[\"[a-z]+\"]]}];\n  ToString[total + cur]];", "Code"],

Cell["(* Gives the tidied sentence, with \" | \" between steps, and the figures of speech set aside *)\nnormalise[s_String] := Module[{t, idioms},\n  t = StringReplace[ToLowerCase[s], {\"\\:2019\" -> \"'\", \"\\:2018\" -> \"'\", \"\\:201c\" -> \"\\\"\", \"\\:201d\" -> \"\\\"\"}];\n  t = StringReplace[t, RegularExpression[\"\\\\b(?:um+|uh+|uhm|er+|erm|hmm+)\\\\b\"] -> \" \"];   (* filler words *)\n  t = StringReplace[t, RegularExpression[\"\\\\b(\\\\w+)(?:\\\\s+\\\\1\\\\b)+\"] -> \"$1\"];               (* stutters: \"spin spin\" *)\n  t = StringReplace[t, dictationFixes[]];\n  t = StringReplace[t, numberWordsRE[] :> wordsToNumber[\"$0\"]];\n  idioms = Flatten[StringCases[t, RegularExpression /@ $MotionVocabulary[\"idioms\"]]];\n  t = StringReplace[t, (RegularExpression[#] -> \" \") & /@ $MotionVocabulary[\"idioms\"]];\n  t = StringReplace[t, {\n     RegularExpression[\"counter[- ]?clockwise|anti[- ]?clockwise\"] -> \"counterclockwise\",\n     \"\\[Degree]\" -> \" degrees \", \"\\:00b0\" -> \" degrees \",\n     RegularExpression[\"\\\\b([xyz])[- ]axis\\\\b\"] -> \"$1 axis\",\n     \"centre\" -> \"center\",\n     RegularExpression[\"\\\\band an? half\\\\b\"] -> \" andahalf \",\n     RegularExpression[\"\\\\band an? quarter\\\\b\"] -> \" andaquarter \",\n     RegularExpression[\"\\\\b(?:and then|after that|followed by|afterwards|then|next|finally|lastly|later|subsequently)\\\\b\"] -> \" | \",\n     RegularExpression[\"\\\\b(?:first|firstly)\\\\b\"] -> \" \",\n     RegularExpression[\"(?<!\\\\d)\\\\.|\\\\.(?!\\\\d)|;\"] -> \" | \"}];\n  {t, idioms}];", "Code"],

Cell["sentences[text_String] := Select[StringTrim /@ StringSplit[text, RegularExpression[\"(?<=[.!?;])\\\\s+|\\\\n+\"]], # =!= \"\" &];", "Code"],

Cell["words[s_String] := StringCases[s, RegularExpression[\"[a-z]+|\\\\d+(?:\\\\.\\\\d+)?\"]];", "Code"],

Cell["Steps in time: then, after, before", "Section"],

Cell["splitAtWord[s_String, k_Integer] := With[{p = StringPosition[s, RegularExpression[\"[a-z]+|\\\\d+(?:\\\\.\\\\d+)?\"], Overlaps -> False][[k, 1]]},\n  {StringTake[s, p - 1], StringDrop[s, p - 1]}];", "Code"],

Cell["(* \"after X, Y\" or \"after X Y\": X happens first; \"before X, Y\": Y happens first *)\nsplitLead[rest_String, beforeQ_] := Module[{parts, w, k},\n  parts = If[StringContainsQ[rest, \",\"], StringSplit[rest, \",\", 2],\n    w = words[rest];\n    k = SelectFirst[Range[2, Length[w]], MemberQ[verbForms[], w[[#]]] && ! StringEndsQ[w[[#]], \"ing\"] &, None];\n    If[k === None, {rest}, splitAtWord[rest, k]]];\n  If[Length[parts] < 2, parts, If[beforeQ, Reverse[parts], parts]]];", "Code"],

Cell["orderStage[s_String] := With[{t = StringTrim[s]},\n  Which[\n   StringStartsQ[t, \"after \"], splitLead[StringDrop[t, 6], False],\n   StringStartsQ[t, \"before \"], splitLead[StringDrop[t, 7], True],\n   StringContainsQ[t, RegularExpression[\"\\\\bafter\\\\b\"]], Reverse[StringSplit[t, RegularExpression[\"\\\\bafter\\\\b\"], 2]],\n   StringContainsQ[t, RegularExpression[\"\\\\bbefore\\\\b\"]], StringSplit[t, RegularExpression[\"\\\\bbefore\\\\b\"], 2],\n   True, {t}]];", "Code"],

Cell["stagesOf[t_String] := Select[StringTrim /@ Flatten[orderStage /@ StringSplit[t, \"|\"]], # =!= \"\" &];", "Code"],

Cell["Parts of a step: together, or one after another", "Section"],

Cell["$sepRE = \"\\\\s*(?:,\\\\s*(?:and\\\\b\\\\s*)?|\\\\b(?:while|whilst|and|as|meanwhile|simultaneously)\\\\b)\\\\s*\";", "Code"],

Cell["connKind[sep_String] := Which[StringStartsQ[StringTrim[sep], \",\"], \"comma\",\n   StringContainsQ[sep, RegularExpression[\"\\\\b(?:while|whilst|as|meanwhile|simultaneously)\\\\b\"]], \"while\", True, \"and\"];\njoinIntro[old_, k_] := Which[old === \"none\", k, old === \"while\" || k === \"while\", \"while\", old === \"start\", \"start\",\n   old === \"and\" || k === \"and\", \"and\", True, \"comma\"];", "Code"],

Cell["(* Run-on speech with no joining words: each motion verb after the first starts a new part, said at\n   the same time, unless the word is a unit (\"a quarter turn\") or a noun after \"the\", \"a\", \"your\"... *)\nverbSplit[text_String] := Module[{w = words[text], vf = verbForms[], units, dets, vs, ks, bounds},\n  units = Join[$MotionVocabulary[\"angleUnits\"], $MotionVocabulary[\"distanceUnits\"]];\n  dets = {\"to\", \"the\", \"a\", \"an\", \"your\", \"its\", \"his\", \"her\", \"their\", \"my\", \"our\", \"this\", \"that\"};\n  vs = Select[Range[Length[w]], MemberQ[vf, w[[#]]] && ! MemberQ[units, w[[#]]] && (# == 1 || ! MemberQ[dets, w[[# - 1]]]) &];\n  ks = If[Length[vs] < 2, {}, Rest[vs]];\n  If[ks === {}, {text},\n   bounds = Join[{1}, StringPosition[text, RegularExpression[\"[a-z]+|\\\\d+(?:\\\\.\\\\d+)?\"], Overlaps -> False][[ks, 1]], {StringLength[text] + 1}];\n   Table[StringTrim[StringTake[text, {bounds[[i]], bounds[[i + 1]] - 1}]], {i, Length[bounds] - 1}]]];", "Code"],

Cell["clausesOf[stage_String] := Module[{pos, items = {}, last = 1, intro = \"start\", out = {}},\n  pos = StringPosition[stage, RegularExpression[$sepRE], Overlaps -> False];\n  Do[AppendTo[items, StringTake[stage, {last, p[[1]] - 1}]]; AppendTo[items, sep[StringTake[stage, p]]]; last = p[[2]] + 1, {p, pos}];\n  AppendTo[items, StringTake[stage, {last, -1}]];\n  Do[If[Head[it] === sep, intro = joinIntro[intro, connKind[First[it]]],\n     If[StringTrim[it] =!= \"\",\n      With[{parts = verbSplit[StringTrim[it]]},\n       AppendTo[out, {intro, First[parts]}]; Scan[AppendTo[out, {\"and\", #}] &, Rest[parts]]];\n      intro = \"none\"]], {it, items}];\n  out];", "Code"],

Cell["(* A comma starts a new step when both sides have their own motion verb, as in a list of actions:\n   \"it moved forward 3 metres, turned left, and moved forward 2 metres\". A leading \"-ing\" part or a\n   \"while\" part stays together: \"spinning counterclockwise, move upwards\". *)\nnewStepQ[p_, c_] := c[\"Intro\"] === \"comma\" && p[\"HasVerb\"] && c[\"HasVerb\"] && ! p[\"IngStart\"] && ! c[\"IngStart\"] &&\n   p[\"Intro\"] =!= \"while\";", "Code"],

Cell["groupsOf[stage_String, o_] := Module[{cl, groups = {}, cur = {}},\n  cl = Function[c, With[{r = readClause[c[[2]], o]}, If[r === Nothing, Nothing, Append[r, \"Intro\" -> c[[1]]]]]] /@ clausesOf[stage];\n  Do[If[cur =!= {} && newStepQ[Last[cur], c], AppendTo[groups, cur]; cur = {c}, AppendTo[cur, c]], {c, cl}];\n  If[cur =!= {}, AppendTo[groups, cur]];\n  groups];", "Code"],

Cell["(* All the groups of a sentence, in order. Each part also notes the part before it in the sentence\n   (\"Prev\") and how it was joined (\"then\" at the start of a later step), for the subject check. *)\nsentenceGroups[t_String, o_] := Module[{gl, flat, lens},\n  gl = Flatten[MapIndexed[Function[{st, i},\n      Map[If[First[i] > 1 && #[\"Intro\"] === \"start\", Append[#, \"Intro\" -> \"then\"], #] &, groupsOf[st, o], {2}]],\n     stagesOf[t]], 1];\n  flat = Flatten[gl, 1]; lens = Length /@ gl;\n  flat = MapThread[Append[#1, \"Prev\" -> #2] &, {flat, Prepend[Most[#[\"Text\"] & /@ flat], \"\"]}];\n  TakeList[flat, lens]];", "Code"],

Cell["(* Keep the motion parts of a step, set the rest aside, and join stray words to the spin they describe *)\nsettleGroup[g_, o_] := Module[{keep = {}, skipped = {}, verbQ, spinAt, frags},\n  verbQ = AnyTrue[g, #[\"HasVerb\"] && ! #[\"Negated\"] && #[\"Kind\"] =!= \"unknown\" &];\n  Do[Which[\n     c[\"Negated\"], AppendTo[skipped, <|\"Text\" -> c[\"Text\"], \"Reason\" -> \"negated\"|>],\n     c[\"Kind\"] === \"unknown\", AppendTo[skipped, <|\"Text\" -> c[\"Text\"], \"Reason\" -> \"no motion words\"|>],\n     c[\"Kind\"] === \"translate\" && ! c[\"HasVerb\"] && ! verbQ,\n      AppendTo[skipped, <|\"Text\" -> c[\"Text\"], \"Reason\" -> \"a direction with no motion verb\"|>],\n     c[\"Kind\"] === \"translate\" && c[\"Bare\"],\n      AppendTo[skipped, <|\"Text\" -> c[\"Text\"], \"Reason\" -> \"a motion verb with no direction or distance\"|>],\n     o[\"SubjectCheck\"] =!= None && c[\"HasVerb\"] && With[{r = MotionSubject[c]}, AssociationQ[r] && o[\"SubjectCheck\"][r] === \"other\"],\n      AppendTo[skipped, <|\"Text\" -> c[\"Text\"], \"Reason\" -> \"about something else (subject check)\"|>],\n     True, AppendTo[keep, c]], {c, g}];\n  spinAt = FirstPosition[keep, c_ /; MemberQ[{\"spin\", \"orbit\"}, c[\"Kind\"]] && c[\"HasVerb\"], None, {1}];\n  If[spinAt =!= None,\n   frags = Select[keep, ! #[\"HasVerb\"] && (#[\"Kind\"] === \"spin\" || (#[\"Kind\"] === \"translate\" && #[\"AxisOnly\"])) &];\n   If[frags =!= {},\n    keep = MapAt[readClause[StringRiffle[Prepend[#[\"Text\"] & /@ frags, #[\"Text\"]], \" \"], o] &, keep, spinAt];\n    keep = DeleteCases[keep, Alternatives @@ frags]]];\n  {keep, skipped}];", "Code"],

Cell["Reading one part", "Section"],

Cell["negatedQ[text_String] := StringContainsQ[text, RegularExpression[\"\\\\b(?:not|never|cannot|dont|no longer)\\\\b|n't\\\\b\"]];", "Code"],

Cell["dictionaryWordQ[w_String] := dictionaryWordQ[w] = TrueQ[Quiet[DictionaryWordQ[w]]];", "Code"],

Cell["correctWord[w_String] := Module[{known = knownWords[], d, cands},\n  Which[\n   StringLength[w] < 5 || MemberQ[known, w] || StringMatchQ[w, NumberString], w,\n   dictionaryWordQ[w], w,\n   True,\n   d = If[StringLength[w] <= 6, 1, 2];\n   cands = Select[known, StringLength[#] >= 5 && StringTake[#, 1] === StringTake[w, 1] &&\n       DamerauLevenshteinDistance[w, #] <= d &];\n   If[cands === {}, w, First[SortBy[cands, DamerauLevenshteinDistance[w, #] &]]]]];", "Code"],

Cell["readClause[text_String, o_Association] := Module[{w0 = words[text], w, corr = {}, vf = verbForms[]},\n  If[w0 === {}, Return[Nothing, Module]];\n  w = Function[x, With[{y = correctWord[x]}, If[y =!= x, AppendTo[corr, x -> y]]; y]] /@ w0;\n  Join[readWords[text, w, o], <|\"HasVerb\" -> IntersectingQ[w, vf],\n    \"IngStart\" -> With[{fv = SelectFirst[w, MemberQ[vf, #] &, None]}, fv =!= None && StringEndsQ[fv, \"ing\"]],\n    \"Negated\" -> negatedQ[text], \"Corrections\" -> corr|>]];", "Code"],

Cell["numberValue[w_List] := Module[{v = $MotionVocabulary[\"numbers\"], ws, plain},\n  ws = Select[w, KeyExistsQ[v, #] || StringMatchQ[#, NumberString] &];\n  If[Complement[ws, {\"a\", \"an\"}] === {}, Return[Missing[\"NotGiven\"]]];\n  plain = DeleteCases[ws, \"andahalf\" | \"andaquarter\"];\n  Times @@ (If[KeyExistsQ[v, #], v[#], ToExpression[#]] & /@ plain) +\n   If[MemberQ[ws, \"andahalf\"], 1/2, 0] + If[MemberQ[ws, \"andaquarter\"], 1/4, 0]];", "Code"],

Cell["notUnderstood[w_List] := With[{k = knownWords[]},\n  DeleteDuplicates@Select[w, ! MemberQ[k, #] && ! StringMatchQ[#, NumberString] &]];", "Code"],

Cell["readWords[text_, w_, o_] := Module[{v = $MotionVocabulary, has, n, axisW, axisQ, axis, senseW, lr, dirW,\n   kind, assumed = {}, base, sense, ang, vec, dist, axisOnly = False, bare = False},\n  has[key_] := IntersectingQ[w, v[key]];\n  n = numberValue[w];\n  axisW = Select[w, KeyExistsQ[v[\"axes\"], #] &]; axisQ = axisW =!= {};\n  axis = If[axisQ, v[\"axes\"][First[axisW]], {0, 0, 1}];\n  senseW = Select[w, KeyExistsQ[v[\"senses\"], #] &];\n  lr = Select[w, MemberQ[{\"left\", \"right\"}, #] &];\n  dirW = Select[w, KeyExistsQ[v[\"directions\"], #] &];\n  If[MemberQ[dirW, \"back\"] && IntersectingQ[dirW, {\"up\", \"upward\", \"upwards\", \"down\", \"downward\", \"downwards\"}],\n   dirW = DeleteCases[dirW, \"back\"]];                               (* \"raise it back up\": back means again *)\n  kind = Which[\n    has[\"pause\"], \"pause\",\n    MemberQ[w, \"path\"] || has[\"follow\"], \"path\",\n    has[\"orbit\"] || (IntersectingQ[w, {\"around\", \"about\"}] && IntersectingQ[w, {\"origin\", \"center\", \"point\"}]), \"orbit\",\n    has[\"spin\"] || (senseW =!= {} && ! has[\"translate\"]), \"spin\",\n    has[\"rise\"] || has[\"sink\"] || has[\"translate\"] || dirW =!= {} || axisQ, \"translate\",\n    True, \"unknown\"];\n  base = <|\"Text\" -> text, \"Kind\" -> kind|>;\n  Switch[kind,\n   \"spin\" | \"orbit\",\n    If[! axisQ, AppendTo[assumed, \"no axis: z (vertical) assumed\"]];\n    sense = Which[\n      senseW =!= {}, v[\"senses\"][First[senseW]],\n      kind === \"spin\" && lr =!= {}, If[First[lr] === \"left\", 1, -1],\n      True, AppendTo[assumed, \"no direction of turning: counterclockwise assumed\"]; 1];\n    ang = Which[\n      ! MissingQ[n], n Which[IntersectingQ[w, {\"degree\", \"degrees\"}], Pi/180,\n        IntersectingQ[w, {\"radian\", \"radians\"}], 1, True, 2 Pi],\n      kind === \"spin\" && lr =!= {}, AppendTo[assumed, \"no amount: a quarter turn assumed (turn \" <> First[lr] <> \")\"]; Pi/2,\n      kind === \"spin\" && MemberQ[w, \"around\"] && IntersectingQ[w, {\"turn\", \"turns\", \"turned\", \"turning\"}] && ! axisQ,\n       AppendTo[assumed, \"\\\"turn around\\\": a half turn\"]; Pi,\n      True, AppendTo[assumed, \"no amount: one full turn assumed\"]; 2 Pi];\n    base = Join[base, <|\"Axis\" -> axis, \"Sense\" -> sense, \"Angle\" -> ang|>];\n    If[kind === \"orbit\", base[\"Centre\"] = If[MemberQ[w, \"origin\"], {0, 0, 0}, o[\"Centre\"]]],\n   \"translate\",\n    vec = Which[\n      dirW =!= {}, Total[v[\"directions\"] /@ dirW],\n      has[\"rise\"], {0, 0, 1}, has[\"sink\"], {0, 0, -1}, axisQ, axisOnly = ! (has[\"translate\"] || has[\"rise\"] || has[\"sink\"]); axis,\n      True, bare = MissingQ[n]; AppendTo[assumed, \"no direction: forward (+y) assumed\"]; {0, 1, 0}];\n    If[vec === {0, 0, 0}, AppendTo[assumed, \"the directions cancel: no movement\"], vec = Normalize[vec]];\n    dist = If[MissingQ[n], AppendTo[assumed, \"no distance: \" <> ToString[o[\"Step\"]] <> \" unit assumed\"]; o[\"Step\"], n];\n    base = Join[base, <|\"Vector\" -> vec, \"Distance\" -> dist|>],\n   \"path\",\n    If[! o[\"PathGiven\"], AppendTo[assumed, \"no path given: the default curve {3 t, Sin[2 Pi t], 0} is used\"]];\n    If[dirW =!= {} || has[\"rise\"] || has[\"sink\"],                    (* \"move upwards along the path\" *)\n     vec = Normalize[Which[dirW =!= {}, Total[v[\"directions\"] /@ dirW], has[\"rise\"], {0, 0, 1}, True, {0, 0, -1}]];\n     base = Join[base, <|\"Vector\" -> vec, \"Distance\" -> If[MissingQ[n], o[\"Step\"], n]|>]],\n   _, Null];\n  Join[base, <|\"Assumed\" -> assumed, \"NotUnderstood\" -> notUnderstood[w], \"AxisOnly\" -> axisOnly, \"Bare\" -> bare|>]];", "Code"],

Cell["From parts to transforms", "Section"],

Cell["clean[x_] := If[Precision[x] === Infinity, Simplify[x], Chop[x]];", "Code"],

Cell["framed[M_, vec_, o_] := If[o[\"Frame\"] === \"Object\", M . vec, vec];", "Code"],

Cell["offsetOf[a_, o_, M_, u_] := Switch[a[\"Kind\"],\n  \"translate\", framed[M, a[\"Distance\"] a[\"Vector\"], o] u,\n  \"path\", framed[M, o[\"Path\"][u] - o[\"Path\"][0], o] + If[KeyExistsQ[a, \"Vector\"], framed[M, a[\"Distance\"] a[\"Vector\"], o] u, 0],\n  _, {0, 0, 0}];", "Code"],

Cell["(* The piece of transform one part contributes, in the step time u *)\nclausePiece[a_, o_, M_ : IdentityMatrix[3], u_ : \\[FormalT]] := Switch[a[\"Kind\"],\n  \"translate\" | \"path\", Inactive[TranslationTransform][offsetOf[a, o, M, u]],\n  \"spin\", Inactive[RotationTransform][a[\"Sense\"] a[\"Angle\"] u, a[\"Axis\"]],\n  \"orbit\", Inactive[RotationTransform][a[\"Sense\"] a[\"Angle\"] u, a[\"Axis\"], a[\"Centre\"]],\n  _, Nothing];", "Code"],

Cell["(* One step: orbits . translation to the current position . spins . the orientation so far *)\nstageFormula[prims_List, P0_, M_, o_] := Module[{u = \\[FormalT], off, spins, orbits, pos, pieces, f, mat},\n  off = Total[Join[{{0, 0, 0}}, offsetOf[#, o, M, u] & /@ Select[prims, MemberQ[{\"translate\", \"path\"}, #[\"Kind\"]] &]]];\n  spins = Cases[prims, a_ /; a[\"Kind\"] === \"spin\" :> clausePiece[a, o]];\n  orbits = Cases[prims, a_ /; a[\"Kind\"] === \"orbit\" :> clausePiece[a, o]];\n  pos = clean[P0 + off];\n  pieces = Join[orbits,\n    If[TrueQ[pos == {0, 0, 0}], {}, {Inactive[TranslationTransform][pos]}],\n    spins,\n    If[TrueQ[M == IdentityMatrix[3]], {}, {Inactive[AffineTransform][{M, {0, 0, 0}}]}]];\n  f = Switch[Length[pieces], 0, Inactive[TranslationTransform][{0, 0, 0}], 1, First[pieces], _, Inactive[Dot] @@ pieces];\n  mat = TransformationMatrix[Activate[f /. u -> 1]];\n  {f, clean[mat[[1 ;; 3, 4]]], clean[mat[[1 ;; 3, 1 ;; 3]]]}];", "Code"],

Cell["pad3[p_List] := PadRight[p, 3];", "Code"],

Cell["resolvePath[Automatic] := Function[s, {3 s, Sin[2 Pi s], 0}];\nresolvePath[pts_List?(MatrixQ[#, NumericQ] &)] := Module[{p = pad3 /@ pts, n},\n  n = Length[p];\n  If[n == 1, Function[s, Evaluate[First[p]]],\n   Function[s, Evaluate[Table[Piecewise[Table[\n         {p[[k, c]] + (p[[k + 1, c]] - p[[k, c]]) ((n - 1) s - (k - 1)), (k - 1)/(n - 1) <= s <= k/(n - 1)},\n         {k, n - 1}]], {c, 3}]]]]];\nresolvePath[f_] := Function[s, pad3[f[s]]];", "Code"],

Cell["(* What a subject check sees of a motion part (see nets/SubjectNet.nb) *)\nMotionSubject[c_Association] := Module[{w = words[c[\"Text\"]], vf = verbForms[], i},\n  i = FirstPosition[w, x_ /; MemberQ[vf, x], {None}, {1}][[1]];\n  If[i === None, Missing[\"NoVerb\"],\n   <|\"Text\" -> c[\"Text\"], \"Own\" -> Take[w, i - 1], \"Verb\" -> w[[i]], \"After\" -> Drop[w, i],\n    \"Prev\" -> If[i == 1, words[Lookup[c, \"Prev\", \"\"]], {}], \"Join\" -> Lookup[c, \"Intro\", \"start\"]|>]];", "Code"],

Cell["Options[MotionParse] = {\"Path\" -> Automatic, \"Centre\" -> {0, 0, 0}, \"Step\" -> 1, \"Frame\" -> \"World\", \"SubjectCheck\" -> None};", "Code"],

Cell["(* Reading: the steps found, what was set aside, and the figures of speech *)\nreadText[text_String, o_] := Module[{stages = {}, skipped = {}, idioms = {}, t, ids, kept, sk},\n  Do[\n   If[StringEndsQ[sent, \"?\"], AppendTo[skipped, <|\"Text\" -> sent, \"Reason\" -> \"a question\"|>],\n    {t, ids} = normalise[sent];\n    idioms = Join[idioms, ids];\n    Do[\n     {kept, sk} = settleGroup[g, o];\n     skipped = Join[skipped, sk];\n     If[kept =!= {}, AppendTo[stages, kept]],\n     {g, sentenceGroups[t, o]}]],\n   {sent, sentences[text]}];\n  {stages, skipped, DeleteDuplicates[StringTrim /@ idioms]}];", "Code"],

Cell["optionsOf[opts_List] := <|\"Path\" -> resolvePath[OptionValue[MotionParse, opts, \"Path\"]],\n   \"PathGiven\" -> OptionValue[MotionParse, opts, \"Path\"] =!= Automatic,\n   \"Centre\" -> pad3[OptionValue[MotionParse, opts, \"Centre\"]], \"Step\" -> OptionValue[MotionParse, opts, \"Step\"],\n   \"Frame\" -> OptionValue[MotionParse, opts, \"Frame\"], \"SubjectCheck\" -> OptionValue[MotionParse, opts, \"SubjectCheck\"]|>;", "Code"],

Cell["MotionParse[text_String, opts : OptionsPattern[]] := Module[{o, stages, skipped, idioms,\n   formulas = {}, P0 = {0, 0, 0}, M = IdentityMatrix[3], f, res},\n  o = <|\"Path\" -> resolvePath[OptionValue[\"Path\"]], \"PathGiven\" -> OptionValue[\"Path\"] =!= Automatic,\n    \"Centre\" -> pad3[OptionValue[\"Centre\"]], \"Step\" -> OptionValue[\"Step\"], \"Frame\" -> OptionValue[\"Frame\"],\n    \"SubjectCheck\" -> OptionValue[\"SubjectCheck\"]|>;\n  {stages, skipped, idioms} = readText[text, o];\n  Do[{f, P0, M} = stageFormula[st, P0, M, o]; AppendTo[formulas, f], {st, stages}];\n  If[formulas === {}, formulas = {Inactive[TranslationTransform][{0, 0, 0}]}];\n  res = <|\"Phrase\" -> text, \"Stages\" -> stages, \"Formulas\" -> formulas,\n    \"End\" -> <|\"Position\" -> P0, \"Orientation\" -> M|>, \"Skipped\" -> skipped,\n    \"Idioms\" -> idioms, \"Options\" -> o|>;\n  Append[res, \"Report\" -> report[res]]];", "Code"],

Cell["(* Reading only, without working out the transforms *)\nMotionFind[text_String, opts : OptionsPattern[MotionParse]] := With[{r = readText[text, optionsOf[{opts}]]},\n  <|\"Motions\" -> Map[#[\"Text\"] &, r[[1]], {2}], \"Set aside\" -> r[[2]], \"Figures of speech\" -> r[[3]]|>];", "Code"],

Cell["MotionFormula[text_String, opts : OptionsPattern[MotionParse]] := MotionParse[text, opts][\"Formulas\"];", "Code"],

Cell["transformAt[fs_List, t_] := With[{n = Length[fs]},\n  Which[\n   NumericQ[t], With[{k = Clip[Floor[t n] + 1, {1, n}]}, Activate[fs[[k]] /. \\[FormalT] -> t n - (k - 1)]],\n   n == 1, Activate[fs[[1]] /. \\[FormalT] -> t],\n   True, Table[{{(k - 1)/n, k/n}, Activate[fs[[k]] /. \\[FormalT] -> t n - (k - 1)]}, {k, n}]]];", "Code"],

Cell["Options[MotionTransform] = Options[MotionParse];\nMotionTransform[text_String, t_, opts : OptionsPattern[]] := transformAt[MotionFormula[text, opts], t];", "Code"],

Cell["The report", "Section"],

Cell["tstr[e_] := StringReplace[ToString[e /. \\[FormalT] -> displayT, InputForm],\n   {\"MotionPhrases`Private`displayT\" -> \"t\", \"displayT\" -> \"t\"}];", "Code"],

Cell["pieceString[Inactive[h_][args___]] := SymbolName[h] <> \"[\" <> StringRiffle[tstr /@ {args}, \", \"] <> \"]\";\nformulaString[Inactive[Dot][ps___]] := StringRiffle[pieceString /@ {ps}, \" . \"];\nformulaString[p_] := pieceString[p];", "Code"],

Cell["senseName[s_] := If[s > 0, \"counterclockwise\", \"clockwise\"];", "Code"],

Cell["desc[a_, o_] := Switch[a[\"Kind\"],\n  \"translate\", \"move \" <> tstr[a[\"Distance\"]] <> \" along \" <> tstr[a[\"Vector\"]] <>\n    If[o[\"Frame\"] === \"Object\", \" (in the object's own frame)\", \"\"],\n  \"path\", \"follow the path, from where the object is\" <>\n    If[KeyExistsQ[a, \"Vector\"], \", while moving \" <> tstr[a[\"Distance\"]] <> \" along \" <> tstr[a[\"Vector\"]], \"\"],\n  \"spin\", \"spin about its own centre, axis \" <> tstr[a[\"Axis\"]] <> \", by \" <> tstr[a[\"Angle\"]] <> \", \" <> senseName[a[\"Sense\"]],\n  \"orbit\", \"orbit about \" <> tstr[a[\"Centre\"]] <> \", axis \" <> tstr[a[\"Axis\"]] <> \", by \" <> tstr[a[\"Angle\"]] <> \", \" <> senseName[a[\"Sense\"]],\n  \"pause\", \"stay still\",\n  _, \"\"];", "Code"],

Cell["clauseLine[a_, o_] := \"  \\[Checkmark] \\\"\" <> a[\"Text\"] <> \"\\\" \\[RightArrow] \" <> desc[a, o] <>\n   If[a[\"Kind\"] === \"pause\", \"\", \": \" <> pieceString[clausePiece[a, o]]];", "Code"],

Cell["report[res_] := Module[{st = res[\"Stages\"], o = res[\"Options\"], n, lines},\n  n = Length[st];\n  lines = {\"Text: \\\"\" <> res[\"Phrase\"] <> \"\\\"\"};\n  If[n == 0, AppendTo[lines, \"\:26a0 no motion was found; the object stays where it is\"]];\n  Do[\n   AppendTo[lines, \"Step \" <> ToString[k] <> \" of \" <> ToString[n] <> If[Length[st[[k]]] > 1, \", all at the same time:\", \":\"]];\n   Do[\n    AppendTo[lines, clauseLine[a, o]];\n    Scan[AppendTo[lines, \"      \\[RightArrow] read \\\"\" <> #[[1]] <> \"\\\" as \\\"\" <> #[[2]] <> \"\\\"\"] &, a[\"Corrections\"]];\n    Scan[AppendTo[lines, \"      \:26a0 \" <> #] &, a[\"Assumed\"]];\n    If[a[\"NotUnderstood\"] =!= {}, AppendTo[lines, \"      \:2022 not understood, ignored: \" <> StringRiffle[a[\"NotUnderstood\"], \", \"]]],\n    {a, st[[k]]}];\n   AppendTo[lines, \"  Step transform (t from 0 to 1): \" <> formulaString[res[\"Formulas\"][[k]]]],\n   {k, n}];\n  If[res[\"Skipped\"] =!= {} || res[\"Idioms\"] =!= {}, AppendTo[lines, \"Set aside:\"]];\n  Scan[AppendTo[lines, \"  \:2022 \\\"\" <> #[\"Text\"] <> \"\\\" (\" <> #[\"Reason\"] <> \")\"] &, res[\"Skipped\"]];\n  Scan[AppendTo[lines, \"  \:2022 \\\"\" <> # <> \"\\\" (a figure of speech)\"] &, res[\"Idioms\"]];\n  AppendTo[lines, \"Ends at \" <> tstr[res[\"End\"][\"Position\"]] <>\n    If[TrueQ[res[\"End\"][\"Orientation\"] == IdentityMatrix[3]], \", facing as it started.\", \", turned from how it started.\"]];\n  StringRiffle[lines, \"\\n\"]];", "Code"],

Cell["MotionReport[text_String, opts : OptionsPattern[MotionParse]] := MotionParse[text, opts][\"Report\"];", "Code"],

Cell["Pictures", "Section"],

Cell["$object = {EdgeForm[GrayLevel[0.35]], RGBColor[0.36, 0.6, 0.85], Cuboid[{-0.3, -0.18, -0.1}, {0.3, 0.18, 0.1}],\n   RGBColor[0.85, 0.3, 0.25], Arrow[Tube[{{0, 0, 0}, {0.6, 0, 0}}, 0.03]]};", "Code"],

Cell["Options[MotionPlot] = Join[Options[MotionParse], {\"Object\" -> Automatic, \"Snapshots\" -> 6}];\nMotionPlot[text_String, opts : OptionsPattern[]] := Module[{fs, obj, ts, trace},\n  fs = MotionFormula[text, Sequence @@ FilterRules[{opts}, Options[MotionParse]]];\n  obj = Replace[OptionValue[\"Object\"], Automatic -> $object];\n  ts = Subdivide[0, 1, Max[1, OptionValue[\"Snapshots\"] - 1]];\n  trace = transformAt[fs, #][{0, 0, 0}] & /@ Subdivide[0., 1., 200];\n  Graphics3D[{{GrayLevel[0.55], Dashed, Line[trace]},\n    MapIndexed[{Opacity[0.3 + 0.7 (First[#2] - 1)/Max[1, Length[ts] - 1]],\n       GeometricTransformation[obj, transformAt[fs, N[#1]]]} &, ts]},\n   Axes -> True, AxesLabel -> {\"x\", \"y\", \"z\"}, Boxed -> False, PlotRange -> All, ImageSize -> 420,\n   PlotLabel -> Style[Short[text, 2], 11]]];", "Code"],

Cell["Options[MotionAnimate] = Join[Options[MotionParse], {\"Object\" -> Automatic}];\nMotionAnimate[text_String, opts : OptionsPattern[]] := Module[{fs, obj, trace, pr},\n  fs = MotionFormula[text, Sequence @@ FilterRules[{opts}, Options[MotionParse]]];\n  obj = Replace[OptionValue[\"Object\"], Automatic -> $object];\n  trace = transformAt[fs, #][{0, 0, 0}] & /@ Subdivide[0., 1., 200];\n  pr = {#1 - 0.8, #2 + 0.8} & @@@ (MinMax /@ Transpose[trace]);\n  With[{fs0 = fs, obj0 = obj, trace0 = trace, pr0 = pr},\n   Animate[Graphics3D[{{GrayLevel[0.55], Dashed, Line[trace0]}, GeometricTransformation[obj0, transformAt[fs0, time]]},\n     PlotRange -> pr0, Axes -> True, AxesLabel -> {\"x\", \"y\", \"z\"}, Boxed -> False, ImageSize -> 420,\n     SphericalRegion -> True, PlotLabel -> Style[Short[text, 2], 11]],\n    {time, 0, 1}, AnimationRunning -> False, SaveDefinitions -> True]]];", "Code"],

Cell["End[];\nEndPackage[];", "Code"],

Cell["\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0", "Text"]
}]
