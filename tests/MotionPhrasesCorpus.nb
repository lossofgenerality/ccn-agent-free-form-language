(* Content-type: application/vnd.wolfram.mathematica *)

Notebook[{
Cell["Motion phrases: a larger corpus, and paragraphs", "Title"],

Cell["A larger corpus of spoken motion phrases for MotionPhrases.nb: each base phrase in several\norders that still make sense in English, each with dictation and grammar slips, all scored\nagainst the meaning of the base phrase.", "Text"],

Cell["It also holds twelve paragraph-sized texts with motion phrases inside them, mixed with ordinary\nsentences, figures of speech, questions, negations and dictation slips.", "Text"],

Cell["Run: open this notebook and evaluate it. The first cell loads MotionPhrases.nb from the\nmotion folder; the last cells show the scores and the phrases that were misread.", "Text"],

Cell["Load the package", "Section"],

Cell["corpusFolder = Quiet@Check[NotebookDirectory[], Directory[]];\nNotebookEvaluate[FileNameJoin[{corpusFolder, \"..\", \"motion\", \"MotionPhrases.nb\"}]];", "Code"],

Cell["Checks", "Section"],

Cell["near[a_, b_] := Max[Abs[N[Flatten[{a - b}]]]] < 10^-6;\npose[T_] := TransformationMatrix[T];\nrz[a_] := RotationMatrix[a, {0, 0, 1}];\nrx[a_] := RotationMatrix[a, {1, 0, 0}];", "Code"],

Cell["Base phrases, where they end, and other orders that mean the same", "Section"],

Cell["corpus = {\n  <|\"Base\" -> \"move along the path while spinning counterclockwise and move upwards\", \"End\" -> {{3, 0, 1}, IdentityMatrix[3]},\n    \"Orderings\" -> {\"while spinning counterclockwise, move along the path and move upwards\",\n      \"move upwards and move along the path while spinning counterclockwise\",\n      \"spin counterclockwise while moving along the path and moving upwards\",\n      \"move along the path and upwards while spinning counterclockwise\",\n      \"spinning counterclockwise, move upwards along the path\",\n      \"move upwards along the path while spinning counterclockwise\"}|>,\n  <|\"Base\" -> \"spin clockwise 90 degrees\", \"End\" -> {{0, 0, 0}, rz[-Pi/2]},\n    \"Orderings\" -> {\"spin 90 degrees clockwise\", \"rotate clockwise by 90 degrees\", \"turn 90 degrees clockwise\",\n      \"clockwise, spin 90 degrees\", \"spin clockwise by ninety degrees\"}|>,\n  <|\"Base\" -> \"move up 2 units then turn left then move forward\", \"End\" -> {{0, 1, 2}, rz[Pi/2]},\n    \"Orderings\" -> {\"move 2 units up, then turn left, then move forward\",\n      \"go up two units and then turn left and then go forward\",\n      \"move up 2 then turn to the left then move ahead\",\n      \"after moving up 2 units turn left then move forward\"}|>,\n  <|\"Base\" -> \"move right 2 then orbit counterclockwise around the origin a half turn\", \"End\" -> {{-2, 0, 0}, rz[Pi]},\n    \"Orderings\" -> {\"move 2 to the right, then orbit around the origin counterclockwise by half a turn\",\n      \"move right by 2 and then circle the origin counterclockwise half a turn\",\n      \"move right 2 and then revolve half a turn counterclockwise about the origin\",\n      \"after moving right 2, orbit the origin counterclockwise a half turn\"}|>,\n  <|\"Base\" -> \"spin two and a half turns about the x axis while rising 3\", \"End\" -> {{0, 0, 3}, rx[Pi]},\n    \"Orderings\" -> {\"rise 3 while spinning two and a half turns about the x axis\",\n      \"while rising 3 units, spin about the x axis two and a half turns\",\n      \"rise by 3 as it spins 2.5 turns around the x axis\",\n      \"spin 2.5 turns about the x axis and rise 3\"}|>,\n  <|\"Base\" -> \"slide left 3 units while turning clockwise a quarter turn\", \"End\" -> {{-3, 0, 0}, rz[-Pi/2]},\n    \"Orderings\" -> {\"turn clockwise a quarter turn while sliding 3 units left\",\n      \"while turning a quarter turn clockwise, slide 3 units to the left\",\n      \"slide 3 to the left as it turns clockwise by 90 degrees\",\n      \"slide left 3 units and turn a quarter turn clockwise\"}|>,\n  <|\"Base\" -> \"rise 2 then spin twice then sink 2\", \"End\" -> {{0, 0, 0}, IdentityMatrix[3]},\n    \"Orderings\" -> {\"rise 2, then spin twice, then sink 2\", \"rise by 2 then spin around twice then sink by 2\",\n      \"go up 2, spin twice, then come down 2\", \"first rise 2, next spin twice, finally sink 2\"}|>,\n  <|\"Base\" -> \"move forward 4 while orbiting the origin a full turn\", \"End\" -> {{0, 4, 0}, IdentityMatrix[3]},\n    \"Orderings\" -> {\"orbit the origin a full turn while moving forward 4\",\n      \"while moving 4 units forward, orbit around the origin once\",\n      \"go forward by 4 as it orbits the origin one full turn\"}|>,\n  <|\"Base\" -> \"pause then move down 1\", \"End\" -> {{0, 0, -1}, IdentityMatrix[3]},\n    \"Orderings\" -> {\"wait, then move down 1\", \"pause and then go down 1\", \"hold still then drop 1\",\n      \"move down one unit after a pause\"}|>,\n  <|\"Base\" -> \"spin counterclockwise about the x axis 270 degrees\", \"End\" -> {{0, 0, 0}, rx[3 Pi/2]},\n    \"Orderings\" -> {\"spin 270 degrees counterclockwise about the x axis\",\n      \"rotate about the x axis by 270 degrees counterclockwise\",\n      \"about the x axis, spin counterclockwise 270 degrees\",\n      \"counterclockwise, spin 270 degrees around the x axis\"}|>,\n  <|\"Base\" -> \"move left 2 and up 1\", \"End\" -> {{-2, 0, 1}, IdentityMatrix[3]},\n    \"Orderings\" -> {\"move up 1 and left 2\", \"move 2 to the left and 1 up\",\n      \"go left two units while going up one unit\", \"move left 2 units and 1 unit up\"}|>,\n  <|\"Base\" -> \"follow the path then spin 180 degrees\", \"End\" -> {{3, 0, 0}, rz[Pi]},\n    \"Orderings\" -> {\"follow the path, then spin by 180 degrees\", \"follow the path and then rotate by 180 degrees\",\n      \"after following the path spin 180 degrees\", \"spin 180 degrees after following the path\"}|>\n};", "Code"],

Cell["Dictation and grammar slips", "Section"],

Cell["sr[rules_] := StringReplace[#, rules] &;", "Code"],

Cell["anomalies = <|\n  \"capitals and a full stop\" -> (Capitalize[#] <> \".\" &),\n  \"filler words (um, uh, like)\" -> (\"um \" <> StringReplace[#, {RegularExpression[\"\\\\bwhile\\\\b\"] -> \"uh while\",\n        RegularExpression[\"\\\\bthen\\\\b\"] -> \"then like\"}] &),\n  \"words split by dictation\" -> sr[{\"counterclockwise\" -> \"counter clock wise\", \"clockwise\" -> \"clock wise\",\n     \"upwards\" -> \"up wards\", \"forward\" -> \"for ward\"}],\n  \"homophones\" -> sr[{RegularExpression[\"\\\\bright\\\\b\"] -> \"write\", RegularExpression[\"\\\\btwo\\\\b\"] -> \"too\",\n     RegularExpression[\"\\\\bthen\\\\b\"] -> \"than\", RegularExpression[\"\\\\bfour\\\\b\"] -> \"for\", RegularExpression[\"\\\\bone\\\\b\"] -> \"won\"}],\n  \"misspellings\" -> sr[{\"counterclockwise\" -> \"counterclokwise\", \"clockwise\" -> \"clokwise\", \"spinning\" -> \"spining\",\n     \"rotate\" -> \"rotat\", \"degrees\" -> \"degres\", \"upwards\" -> \"upwrds\", \"origin\" -> \"orgin\"}],\n  \"past tense\" -> sr[{RegularExpression[\"\\\\bspin(ning|s)?\\\\b\"] -> \"spun\", RegularExpression[\"\\\\bmov(e|es|ing)\\\\b\"] -> \"moved\",\n     RegularExpression[\"\\\\bris(e|es|ing)\\\\b\"] -> \"rose\", RegularExpression[\"(?<!\\\\d |half |quarter |full |a )\\\\bturn(s|ing)?\\\\b\"] -> \"turned\",\n     RegularExpression[\"\\\\bslid(e|es|ing)\\\\b\"] -> \"slid\", RegularExpression[\"\\\\bsink(s|ing)?\\\\b\"] -> \"sank\",\n     RegularExpression[\"\\\\borbit(s|ing)?\\\\b\"] -> \"orbited\", RegularExpression[\"\\\\brotat(e|es|ing)\\\\b\"] -> \"rotated\"}],\n  \"wrong verb forms\" -> sr[{RegularExpression[\"\\\\bspinning\\\\b\"] -> \"spin\", RegularExpression[\"\\\\bmoving\\\\b\"] -> \"move\",\n     RegularExpression[\"\\\\brising\\\\b\"] -> \"rise\", RegularExpression[\"\\\\bturning\\\\b\"] -> \"turn\",\n     RegularExpression[\"\\\\borbiting\\\\b\"] -> \"orbit\", RegularExpression[\"\\\\bspins\\\\b\"] -> \"spin\", RegularExpression[\"\\\\bturns\\\\b\"] -> \"turn\"}],\n  \"repeated words\" -> sr[{RegularExpression[\"^(\\\\w+)\"] -> \"$1 $1\", \" the \" -> \" the the \"}],\n  \"run-on, no joining words\" -> sr[{\", \" -> \" \", RegularExpression[\"\\\\b(?:while|as) |\\\\band (?!a half|a quarter|then)\"] -> \"\"}],\n  \"numbers spelled out\" -> sr[{RegularExpression[\"\\\\b2\\\\.5\\\\b\"] -> \"two and a half\", RegularExpression[\"\\\\b90\\\\b\"] -> \"ninety\",\n     RegularExpression[\"\\\\b180\\\\b\"] -> \"a hundred and eighty\", RegularExpression[\"\\\\b270\\\\b\"] -> \"two hundred and seventy\",\n     RegularExpression[\"\\\\b1\\\\b\"] -> \"one\", RegularExpression[\"\\\\b2\\\\b\"] -> \"two\", RegularExpression[\"\\\\b3\\\\b\"] -> \"three\",\n     RegularExpression[\"\\\\b4\\\\b\"] -> \"four\"}],\n  \"numbers as digits\" -> sr[{\"two and a half\" -> \"2.5\", RegularExpression[\"\\\\bone\\\\b\"] -> \"1\", RegularExpression[\"\\\\btwo\\\\b\"] -> \"2\",\n     RegularExpression[\"\\\\bthree\\\\b\"] -> \"3\", RegularExpression[\"\\\\bfour\\\\b\"] -> \"4\"}],\n  \"degree sign and hyphens\" -> sr[{\" degrees\" -> \"\\[Degree]\", \"x axis\" -> \"x-axis\", \"counterclockwise\" -> \"counter-clockwise\"}]\n|>;", "Code"],

Cell["Scoring: a phrase is read right when it matches the base at t = 0.37 and at the end", "Section"],

Cell["expected[base_] := {MotionTransform[base, 1], MotionTransform[base, 0.37]};", "Code"],

Cell["readRight[p_, exp_] := Quiet@Check[\n    near[pose[MotionTransform[p, 1]], pose[exp[[1]]]] && near[pose[MotionTransform[p, 0.37]], pose[exp[[2]]]], False];", "Code"],

Cell["reading[p_] := With[{r = MotionParse[p]},\n   {r[\"Stages\"][[All, All, \"Kind\"]], DeleteDuplicates@Flatten[r[\"Stages\"][[All, All, \"NotUnderstood\"]]]}];", "Code"],

Cell["basesRight = Table[With[{T = MotionTransform[c[\"Base\"], 1]},\n    near[T[{0, 0, 0}], c[\"End\"][[1]]] && near[pose[T][[1 ;; 3, 1 ;; 3]], c[\"End\"][[2]]]], {c, corpus}];", "Code"],

Cell["rows = Flatten[Table[\n    With[{exp = expected[c[\"Base\"]]},\n     Table[\n      Join[{<|\"Base\" -> c[\"Base\"], \"Ordering\" -> o, \"Slip\" -> \"none\", \"Phrase\" -> o, \"Right\" -> readRight[o, exp]|>},\n       KeyValueMap[Function[{name, f}, With[{p = f[o]},\n          If[p === o, Nothing, <|\"Base\" -> c[\"Base\"], \"Ordering\" -> o, \"Slip\" -> name, \"Phrase\" -> p, \"Right\" -> readRight[p, exp]|>]]],\n        anomalies]],\n      {o, Prepend[c[\"Orderings\"], c[\"Base\"]]}]],\n    {c, corpus}], 2];", "Code"],

Cell["Results", "Section"],

Cell["cleanRows = Select[rows, #Slip === \"none\" &];\ncleanRight = Select[cleanRows, #Right &][[All, \"Ordering\"]];", "Code"],

Cell["orderingScore = <|\"Phrases\" -> Length[rows], \"Bases read right\" -> Count[basesRight, True],\n   \"Orderings\" -> Length[cleanRows], \"Orderings read right\" -> Count[cleanRows, _?(#Right &)]|>;", "Code"],

Cell["orderingsMisread = {#Phrase, reading[#Phrase]} & /@ Select[cleanRows, ! #Right &];", "Code"],

Cell["slipScores = Table[\n   With[{rs = Select[rows, #Slip === name &]},\n    <|\"Slip\" -> name, \"Phrases\" -> Length[rs], \"Read right\" -> Count[rs, _?(#Right &)],\n     \"Share\" -> If[rs === {}, \"-\", ToString[Round[100. Count[rs, _?(#Right &)]/Length[rs]]] <> \"%\"],\n     \"Misread, for example\" -> ({#Phrase, reading[#Phrase]} & /@ Take[Select[rs, ! #Right &], UpTo[3]])|>],\n   {name, Keys[anomalies]}];", "Code"],

Cell["orderingScore", "Code"],

Cell["Dataset[slipScores]", "Code"],

Cell["orderingsMisread", "Code"],

Cell["Paragraphs: motion phrases inside larger text", "Section"],

Cell["(* Each paragraph was written for this test. \"Same as\" is a short phrase with the motions the\n   paragraph holds, in order; a paragraph is read right when it ends where \"Same as\" ends. *)", "Code"],

Cell["paragraphs = {\n  <|\"Title\" -> \"Drone light show script\",\n    \"Text\" -> \"Good evening everyone, and welcome to the harbour light show. Tonight's lead drone starts on the water's edge. First, the drone should rise 4 metres while spinning counterclockwise. The crowd usually cheers at this point, so give it a moment. Then it will move right 3 units. After that, orbit counterclockwise around the origin a half turn. Thank you for coming, and please mind the steps on your way out.\",\n    \"Same as\" -> \"rise 4 while spinning counterclockwise then move right 3 then orbit counterclockwise around the origin a half turn\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"Dance class, dictated (no capitals, slips)\",\n    \"Text\" -> \"okay class um lets start in the middle of the floor. slide left 2 steps and turn a quarter turn clock wise. now slide write too steps. keep your arms loose its all about the rhythm. spin twice counter clock wise. great job everybody we will pick this up next week\",\n    \"Same as\" -> \"slide left 2 while turning a quarter turn clockwise then slide right 2 then spin twice counterclockwise\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"Animation storyboard\",\n    \"Text\" -> \"Scene 4, the kitchen at night. The camera holds on the kettle for a beat. The teapot character hops off the counter: move forward 2 while rising 1. It wobbles, then rotates 180 degrees about the vertical axis to face the cat. The cat does not move. Finally the teapot slides back 2 units and pauses.\",\n    \"Same as\" -> \"move forward 2 while rising 1 then rotate 180 degrees about the vertical axis then slide back 2\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"Robot vacuum log (past tense; turns follow the robot's heading)\",\n    \"Text\" -> \"Cleaning report for Tuesday. At 9:02 the robot left its dock. It moved forward 3 metres, turned left, and moved forward 2 metres. It then spun around twice to free a tangled brush. The battery fell to 40 percent, so it went back 1 metre and stopped. No errors were logged.\",\n    \"Same as\" -> \"move forward 3 then turn left then move forward 2 then spin twice then move back 1\",\n    \"Options\" -> {\"Frame\" -> \"Object\"}|>,\n  <|\"Title\" -> \"Children's game\",\n    \"Text\" -> \"Let's play Robot Says! Robot says: turn on your listening ears. Robot says: step forward 2 steps. Robot says: spin around once. Now, can you jump? Don't move left! Robot says: step back 1 step, then turn right.\",\n    \"Same as\" -> \"step forward 2 then spin once then step back 1 then turn right\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"VR tutorial (numbers in words)\",\n    \"Text\" -> \"Welcome to the sculpture viewer. To inspect the statue, rotate it ninety degrees clockwise about the vertical axis. Next, roll it about the x-axis by one hundred and eighty degrees so you can see the base. If the lighting looks flat, turn off the shadows in the settings menu. Finally, lift it up two units and leave it there.\",\n    \"Same as\" -> \"rotate 90 degrees clockwise about the z axis then spin 180 degrees about the x axis then rise 2\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"Gallery installation description\",\n    \"Text\" -> \"The installation fills the east gallery. Every evening the brass sphere rises 3 metres while it orbits counterclockwise around the centre of the room a full turn. Visitors often say the experience turns their sense of scale upside down. After the sphere settles, it spins slowly clockwise by 45 degrees and holds.\",\n    \"Same as\" -> \"rise 3 while orbiting counterclockwise around the origin a full turn then spin clockwise by 45 degrees\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"Email with instructions and figures of speech\",\n    \"Text\" -> \"Hi Sam, thanks for the notes from Monday. Going forward, let's keep the demo short. For the arm test, please move the gripper down 5 centimetres, then rotate it 30 degrees counterclockwise around the y axis, and then raise it back up 5. Sales numbers rose by 12 percent last quarter, which is great news. Let me know if anything falls behind. Best, Ana\",\n    \"Same as\" -> \"move down 5 then rotate 30 degrees counterclockwise around the y axis then rise 5\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"Short story\",\n    \"Text\" -> \"The kite caught the wind at last. It climbed 6 metres, drifted left 2 metres, and then circled once around the old oak, counterclockwise as always. Mia laughed and turned to her brother. 'Look up!' she shouted, but he was already looking up at the kite.\",\n    \"Same as\" -> \"rise 6 then drift left 2 then orbit counterclockwise around the origin once\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"Meeting minutes (no motions at all)\",\n    \"Text\" -> \"Minutes of the planning meeting. We agreed to move on to the budget after lunch. Turnout rose to 80 percent this year. The team will circle back on the venue question next week. Please turn in your timesheets by Friday, and don't drop the ball on the client report. Overall, things are looking up.\",\n    \"Same as\" -> \"\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"Voice memo, run-on dictation\",\n    \"Text\" -> \"uh note to self for the drone demo um first it should go up three meters than spin counterclokwise twice and than move forward for units while going up won more unit okay that's it\",\n    \"Same as\" -> \"go up 3 then spin counterclockwise twice then move forward 4 while going up 1\",\n    \"Options\" -> {}|>,\n  <|\"Title\" -> \"Studio instructions (after and before)\",\n    \"Text\" -> \"Calibrate the turntable before you start. Spin the model 360 degrees clockwise after raising it 1 unit. Before you photograph it, slide it right 2 units. Finally, wait.\",\n    \"Same as\" -> \"rise 1 then spin 360 degrees clockwise then slide right 2 then pause\",\n    \"Options\" -> {}|>\n};", "Code"],

Cell["paragraphResult[p_] := Module[{opts = p[\"Options\"], r, c, nr, nc, endRight, timeRight},\n  r = MotionParse[p[\"Text\"], Sequence @@ opts];\n  c = MotionParse[p[\"Same as\"], Sequence @@ opts];\n  nr = Length[r[\"Stages\"]]; nc = Length[c[\"Stages\"]];\n  endRight = near[pose[MotionTransform[p[\"Text\"], 1, Sequence @@ opts]], pose[MotionTransform[p[\"Same as\"], 1, Sequence @@ opts]]];\n  timeRight = nr == nc && near[pose[MotionTransform[p[\"Text\"], 0.37, Sequence @@ opts]], pose[MotionTransform[p[\"Same as\"], 0.37, Sequence @@ opts]]];\n  <|\"Paragraph\" -> p[\"Title\"], \"Words\" -> Length[StringSplit[p[\"Text\"]]], \"Steps found\" -> nr, \"Steps expected\" -> nc,\n   \"Ends right\" -> endRight, \"Timing right\" -> timeRight,\n   \"Found\" -> Map[#[\"Text\"] &, r[\"Stages\"], {2}]|>];", "Code"],

Cell["paragraphResults = paragraphResult /@ paragraphs;\nDataset[paragraphResults]", "Code"],

Cell["\:00a9 Computational Classnotes \:00b7 CC BY-NC-SA 4.0", "Text"]
}]
